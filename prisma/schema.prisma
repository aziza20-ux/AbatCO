generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  AGENT
}

enum TransactionType {
  SALE
  TRANSFER
}

enum BicycleStatus {
  ACTIVE
  STOLEN
  DECOMMISSIONED
}

enum FlagStatus {
  NONE
  FLAGGED
  REVIEWED
  CONFLICTED
}

enum SyncOperationStatus {
  PENDING
  APPLIED
  CONFLICTED
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  name         String
  role         Role           @default(AGENT)
  phone        String?
  isActive     Boolean        @default(true)
  transactions Transaction[]
  adminReviews Transaction[] @relation("AdminReviews")
  registrations Registration[]
  auditLogs    AuditLog[]
  refreshTokens RefreshToken[]
  syncOperations SyncOperation[]
  permissions  Json           @default("{\"canRegister\":true,\"canTransfer\":true}")
  resetOtp      String?
  resetOtpExpiry DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model Person {
  id              String         @id @default(cuid())
  name            String
  nationalId      String         @unique
  phone           String?
  cell            String?
  address         String?
  sector          String?
  village         String?
  currentBicycles Bicycle[]      @relation("CurrentOwner")
  registrations   Registration[]
  soldTransactions Transaction[] @relation("Seller")
  boughtTransactions Transaction[] @relation("Buyer")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  @@index([name])
}

model Bicycle {
  id                     String         @id @default(cuid())
  frameNumber            String         @unique
  brand                  String?
  model                  String?
  color                  String?
  distinguishingFeatures String?
  photos                 String[]       @default([])
  currentOwnerId         String?
  currentOwner           Person?        @relation("CurrentOwner", fields: [currentOwnerId], references: [id])
  status                 BicycleStatus  @default(ACTIVE)
  transactions           Transaction[]
  registrations          Registration[]
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  @@index([currentOwnerId])
}

model Transaction {
  id                String          @id @default(cuid())
  type              TransactionType
  bicycleId         String
  bicycle           Bicycle         @relation(fields: [bicycleId], references: [id])
  sellerId          String?
  seller            Person?         @relation("Seller", fields: [sellerId], references: [id])
  buyerId           String?
  buyer             Person?         @relation("Buyer", fields: [buyerId], references: [id])
  recordingAgentId  String
  recordingAgent    User            @relation(fields: [recordingAgentId], references: [id])
  price             Decimal?        @db.Decimal(12, 2)
  reason            String?
  location          String?
  transactionDate   DateTime        @default(now())
  transactionId     String          @unique
  flagStatus        FlagStatus      @default(NONE)
  flagReason        String?
  agentNote         String?
  serviceFee        Decimal?        @db.Decimal(12, 2)
  adminReviewedById String?
  adminReviewedBy   User?           @relation("AdminReviews", fields: [adminReviewedById], references: [id])
  adminReviewedAt   DateTime?
  adminReviewNotes  String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  @@index([bicycleId, transactionDate])
  @@index([recordingAgentId, transactionDate])
  @@index([transactionId])
}

model Registration {
  id               String   @id @default(cuid())
  bicycleId        String
  bicycle          Bicycle  @relation(fields: [bicycleId], references: [id])
  ownerId          String
  owner            Person   @relation(fields: [ownerId], references: [id])
  recordingAgentId String
  recordingAgent   User     @relation(fields: [recordingAgentId], references: [id])
  createdAt        DateTime @default(now())
  @@index([recordingAgentId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String
  timestamp DateTime @default(now())
  metadata  Json?
  @@index([entity, entityId])
  @@index([userId, timestamp])
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?
  replacedById String?
  @@index([userId, expiresAt])
}

model SyncOperation {
  id             String              @id @default(cuid())
  clientOperationId String            @unique
  userId         String
  user           User                @relation(fields: [userId], references: [id])
  entity         String
  entityId       String?
  payload        Json
  status         SyncOperationStatus @default(PENDING)
  conflictReason String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  @@index([userId, status])
}